# SPA na Hostinger (Apache): toda rota que nao e arquivo cai no index.html,
# senao um F5 em /clientes devolve 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Link fixo do instalador do KyberRock Desktop (o antigo /download do loader-web). A Edge
  # Function publica resolve o .exe da versao de producao mais nova no GitHub e redireciona para
  # o arquivo, entao o link nunca muda de uma versao para outra.
  RewriteRule ^download/?$ https://vksihzfrgqoemcqpquit.supabase.co/functions/v1/desktop-download [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Assets com hash no nome podem ficar em cache por muito tempo; o index.html nao.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # O service worker e o manifest nao tem hash no nome: com o cache de 1 ano dos assets, o app
  # instalado no celular ficaria preso na versao antiga.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, max-age=0"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>
