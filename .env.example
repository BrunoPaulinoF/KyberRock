# OMIE API Credentials
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
OMIE_APP_KEY=your_app_key_here
OMIE_APP_SECRET=your_app_secret_here

# Supabase frontend variables (EasyPanel / local dev)
VITE_SUPABASE_URL=https://vksihzfrgqoemcqpquit.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase desktop variables (optional; installed app can also use local settings later)
SUPABASE_URL=https://vksihzfrgqoemcqpquit.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Supabase Edge Function secrets
# SUPABASE_SERVICE_ROLE_KEY is required only in Supabase Edge Functions; never expose it in frontend or desktop builds.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# KYBERROCK_ADMIN_PASSWORD_HASH = sha256(KYBERROCK_ADMIN_PASSWORD_SALT + plain_password)
KYBERROCK_ADMIN_USERNAME=admin
KYBERROCK_ADMIN_PASSWORD_SALT=change_this_random_salt
KYBERROCK_ADMIN_PASSWORD_HASH=sha256_hex_hash_here
KYBERROCK_ADMIN_SESSION_SECRET=change_this_long_random_secret

# SMTP Email Provider (used by daily-report-email Edge Function and desktop test script)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
DAILY_REPORT_SENDER=your_email@gmail.com

# WhatsApp Provider (UAZAPI - optional)
# UAZAPI_INSTANCE_TOKEN also backs the billing WhatsApp (see below).
# UAZAPI_INSTANCE_TOKEN=your_token_here
# UAZAPI_WHATSAPP_URL=https://api.uazapi.com

# Financial backoffice (billing of the platform) — see docs/financeiro.md.
# These are Supabase Edge Function SECRETS, not values stored in the database:
# set them in Supabase > Edge Functions > Secrets (or `supabase secrets set NAME=value`).
# The admin panel only stores the NAME of each variable and shows whether it is filled in;
# the value never reaches the browser, the database or this repository.
# MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token_here
# MERCADO_PAGO_WEBHOOK_SECRET=your_mercado_pago_webhook_signature_secret_here

# Cron scheduler secret (shared between daily-report-scheduler and external cron trigger)
# CRON_SHARED_SECRET=change_this_long_random_secret

# Documentation assistant (docs-assistant Edge Function) — OpenAI.
# The normal place to set the key and the model is the loader-web admin panel ("Assistente de IA"),
# which stores them in public.ai_assistant_settings — one global credential for every quarry.
# The two vars below are only a FALLBACK for installs made before that table existed; when the
# table has a key, it wins. Without either, the function answers 503 and the desktop chat falls
# back to the documentation shipped in the installer. Edge Function secret only — never in the
# desktop build.
# OPENAI_API_KEY=your_openai_api_key_here
# Model override (defaults to gpt-4.1-mini).
# OPENAI_MODEL=gpt-4.1-mini
